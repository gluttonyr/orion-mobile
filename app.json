{
  "expo": {
    "name": "Orion",
    "slug": "orion-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orionmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7f1033",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.koufessi_roland.orionmobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#7F1033",
          "imageWidth": 120,
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#7F1033"
          },
          "ios": {
            "backgroundColor": "#7F1033"
          },
          "image": "./assets/images/splash-icon.png"
        }
      ],
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Autorisez Orion à utiliser votre position pour localiser votre boutique."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4fc1ded9-de98-4018-8701-f1f3ad01d0a6"
      }
    },
    "owner": "koufessi_roland"
  }
}
