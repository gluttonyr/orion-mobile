{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://admin.orion-market.io"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://admin.orion-market.io",
        "EXPO_PUBLIC_WEB_URL": "https://orion-market.io"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://admin.orion-market.io",
        "EXPO_PUBLIC_WEB_URL": "https://orion-market.io"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
